# Public GitHub API token (keep this private; public-read access is enough)
GITHUB_TOKEN=your_github_token_here

# Featherless inference key
FEATHERLESS_API_KEY=your_featherless_api_key_here
SARAL_LLM_PROVIDER=featherless
SARAL_FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
SARAL_CHAT_MODEL=Qwen/Qwen3-8B
SARAL_EMBEDDING_PROVIDER=featherless
SARAL_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
SARAL_EMBEDDING_DIMENSIONS=384
